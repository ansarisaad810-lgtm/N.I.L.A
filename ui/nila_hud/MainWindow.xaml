<Window
    x:Class="NILAHUD.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d">

    <Grid Background="#140B0F19" CornerRadius="16" Padding="20" BorderBrush="#00F0FF" BorderThickness="1.5">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- Header Bar -->
        <Grid Grid.Row="0" Margin="0,0,0,14">
            <StackPanel Orientation="Horizontal" Spacing="10" VerticalAlignment="Center">
                <Ellipse x:Name="StatusOrb" Width="12" Height="12" Fill="#00F0FF">
                    <Ellipse.Shadow>
                        <ThemeShadow />
                    </Ellipse.Shadow>
                </Ellipse>
                <TextBlock x:Name="StatusText" Text="N.I.L.A. // ONLINE" Foreground="#00F0FF" FontSize="13" 
                           FontFamily="Segoe UI Variable Display" FontWeight="Bold" CharacterSpacing="80" />
            </StackPanel>
            <TextBlock HorizontalAlignment="Right" Text="v0.1.0-LOCAL" Foreground="#5580A0" FontSize="10" 
                       FontFamily="Cascadia Code" VerticalAlignment="Center"/>
        </Grid>

        <!-- Output Display Stream -->
        <Border Grid.Row="1" Background="#0A000000" CornerRadius="10" Padding="12" BorderBrush="#1100F0FF" BorderThickness="1">
            <ScrollViewer VerticalScrollBarVisibility="Auto">
                <TextBlock x:Name="ResponseTextBlock" Text="System initialized. Awaiting user input..." 
                           Foreground="#D0E5F5" FontSize="14" TextWrapping="Wrap" 
                           FontFamily="Segoe UI Variable Text" LineHeight="20" />
            </ScrollViewer>
        </Border>

        <!-- Command Input Section -->
        <Grid Grid.Row="2" Margin="0,14,0,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            
            <TextBox x:Name="CommandBox" Grid.Column="0" PlaceholderText="Execute intent or ask N.I.L.A..." 
                     Background="#1A121C2B" Foreground="#FFFFFF" BorderThickness="1" BorderBrush="#3300F0FF" 
                     CornerRadius="8" Padding="10,8" KeyDown="OnCommandKeyDown"
                     FontFamily="Segoe UI Variable Text" />
                     
            <Button Grid.Column="1" Content="EXECUTE" Margin="10,0,0,0" Click="OnSendClick" 
                    Background="#00F0FF" Foreground="#050811" FontWeight="Bold" CornerRadius="8" 
                    Padding="16,8" FontFamily="Segoe UI Variable Display" />
        </Grid>
    </Grid>
</Window>